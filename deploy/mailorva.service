[Unit]
Description=Mailorva aggregation and MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mailorva
Group=mailorva
ExecStart=/opt/mailorva/mailorva-server /etc/mailorva/config.json
WorkingDirectory=/var/lib/mailorva
StateDirectory=mailorva
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mailorva
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
